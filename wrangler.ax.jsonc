{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terrarium-ax",
  "main": "src/control-worker.js",
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./app/dist",
    "binding": "APP_ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/api/*", "/policy", "/campaigns", "/campaigns/*", "/pulse", "/claim", "/ack", "/status"]
  },
  "account_id": "31b91e7f9954ad8aa334d46f012bd8ed",
  "vars": {
    "TERRARIUM_MODE": "fixture",
    "TERRARIUM_BUDGET_MAX_ACTIVE": "20",
    "TERRARIUM_BUDGET_MAX_PER_MINUTE": "120",
    "TERRARIUM_BUDGET_MAX_PER_DAY": "5000",
    "TERRARIUM_STARTUP_GRACE_MS": "90000",
    "TERRARIUM_AI_GATEWAY_ID": "default"
  },
  "kv_namespaces": [
    {
      "binding": "TERRARIUM_LEDGER",
      "id": "e7cc8b3627d04d07b032085f08cdd269"
    },
    {
      "binding": "TERRARIUM_POLICY",
      "id": "c2222cb6471e4ad0ad9f10cac27873d8"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TERRARIUM_ARTIFACTS",
      "bucket_name": "terrarium-ax-artifacts"
    }
  ],
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "CAMPAIGN_LOCK", "class_name": "CampaignLock" },
      { "name": "PULSE_ROUTER", "class_name": "PulseRouter" },
      { "name": "TERRARIUM_RUN", "class_name": "RunControlDO" },
      { "name": "TERRARIUM_SANDBOX", "class_name": "TerrariumSandbox" },
      { "name": "TERRARIUM_PRINCIPAL_BUDGET", "class_name": "PrincipalBudgetDO" }
    ]
  },
  "containers": [
    {
      "class_name": "TerrariumSandbox",
      "image": "./Dockerfile.pi",
      "image_build_context": ".",
      "max_instances": 20
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CampaignLock"] },
    { "tag": "v2", "new_sqlite_classes": ["PulseRouter"] },
    { "tag": "v3", "new_sqlite_classes": ["RunControlDO"] },
    { "tag": "v4", "new_sqlite_classes": ["TerrariumSandbox"] },
    { "tag": "v5", "new_sqlite_classes": ["PrincipalBudgetDO"] }
  ],
  "workflows": [
    {
      "name": "terrarium-campaign",
      "binding": "TERRARIUM_CAMPAIGN",
      "class_name": "TerrariumCampaignWorkflow"
    }
  ]
}
