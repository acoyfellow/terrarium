{
  "name": "terrarium",
  "version": "0.0.1",
  "description": "Execution, status, receipts, cancellation, and callbacks for bounded delegated agent tasks.",
  "type": "module",
  "bin": {
    "terra": "./effect/bin/terra-effect.mjs"
  },
  "scripts": {
    "test": "npm --prefix effect test",
    "gate:effect": "node effect/scripts/gate.mjs",
    "demo:dev": "vite --host 127.0.0.1 --port 5178",
    "demo:build": "vite build",
    "deploy": "vite build && npx wrangler deploy -c effect/wrangler.jsonc",
    "build:public": "VITE_PUBLIC_SITE=1 vite build --outDir dist-public"
  },
  "files": [
    "effect/bin",
    "effect/src",
    "effect/pi-extension",
    "effect/package.json"
  ],
  "bundleDependencies": [
    "terrarium-effect"
  ],
  "keywords": [
    "agent",
    "orchestration",
    "subagent",
    "callbacks",
    "mcp",
    "cli",
    "pi-package"
  ],
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "miniflare": "^4.20260625.0",
    "svelte": "^5.56.4",
    "vite": "^7.3.3",
    "wrangler": "^4.98.0"
  },
  "author": "Jordan Coeyman",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/core.js"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/sandbox": "0.12.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "effect": "^3.21.3",
    "hono": "^4.12.27",
    "mcp-code-mode": "github:acoyfellow/mcp-code-mode#f27af39d5aa020200f712f222c02d682c7ab9c2a",
    "terrarium-effect": "file:vendor/terrarium-effect"
  }
}
