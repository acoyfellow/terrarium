{
  "name": "terrarium",
  "version": "0.0.1",
  "description": "Execution, status, receipts, cancellation, and callbacks for bounded delegated agent tasks.",
  "type": "module",
  "bin": {
    "terrarium": "./src/cli.js",
    "terra": "./src/cli.js",
    "terrarium-mcp": "./src/mcp.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node scripts/test-isolated.mjs",
    "demo": "node src/cli.js \"write a haiku about delegated context\" --dry-run",
    "demo:fanout": "node scripts/demo-fanout.mjs",
    "probe": "node src/cli.js probe filesystem-write-outside-workspace --json",
    "probe:all": "node src/cli.js probe filesystem-write-outside-workspace --json && node src/cli.js probe environment-canary --json && node src/cli.js probe network-disabled --json && node src/cli.js probe filesystem-read-canary --json && node src/cli.js probe process-persistence --json",
    "attack:dry": "node src/cli.js attack environment-canary --agent \"node -e \\\"console.log('TERRARIUM_ATTACK_RESULT={' + String.fromCharCode(34) + 'run' + String.fromCharCode(34) + ':true,' + String.fromCharCode(34) + 'reason' + String.fromCharCode(34) + ':' + String.fromCharCode(34) + 'bounded-detector' + String.fromCharCode(34) + '}')\\\"\" --json",
    "fixture:escape": "node src/cli.js fixture escape",
    "fix:validate": "node scripts/validate-fix.mjs",
    "hardening:verify": "node src/cli.js hardening verify",
    "secure:benchmark": "node scripts/benchmark-secure.mjs",
    "control:dev": "wrangler dev",
    "sync:changelog": "cp CHANGELOG.md app/public/CHANGELOG.md",
    "predemo:dev": "npm run sync:changelog",
    "demo:dev": "vite --host 127.0.0.1 --port 5178",
    "predemo:build": "npm run sync:changelog",
    "demo:build": "vite build",
    "demo:smoke": "node scripts/smoke-demo.mjs",
    "product-loop:once": "node scripts/product-loop.mjs",
    "product-loop:dry-run": "node scripts/product-loop.mjs --dry-run",
    "product-loop:check": "node scripts/product-loop.mjs check",
    "product-loop:validate": "node --test test/product-loop.test.js",
    "deploy": "vite build && wrangler deploy"
  },
  "files": [
    "src",
    "docs/SECURE_V1.md",
    "docs/ARCHITECTURE.md",
    "docs/SECURE_AGENT_PROOF.md",
    "docs/SECURE_AGENT_LANDSCAPE.md",
    "docs/CONCURRENCY_ISOLATION.md",
    "docs/PI_SUBAGENTS_COMPARISON.md",
    "docs/CORE_PRODUCT_DECISION.md",
    "docs/RUN_SCHEDULES.md",
    "fixtures/secure-agent-parser",
    "fixtures/run-schedules"
  ],
  "keywords": [
    "agent",
    "orchestration",
    "subagent",
    "callbacks",
    "mcp",
    "cli",
    "pi-package"
  ],
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "miniflare": "^4.20260625.0",
    "svelte": "^5.56.4",
    "vite": "^7.3.3",
    "wrangler": "^4.98.0"
  },
  "author": "Jordan Coeyman",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/core.js"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/sandbox": "0.12.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "effect": "^3.21.3",
    "hono": "^4.12.27",
    "mcp-code-mode": "github:acoyfellow/mcp-code-mode#f27af39d5aa020200f712f222c02d682c7ab9c2a"
  }
}
